@*
    Sprint 3, Requirement 1 - Global Module Repository (Supervisor View).

    Lets an academic browse Year Level -> Unit -> Module, create a new module
    with a blank EMR structure, copy an existing module for reuse, rename it,
    or delete it. Modules are global: every campus Supervisor login sees the
    same repository, so there is no lab filter anywhere on this screen.
*@
@using EMRSimulation.Domain.Dtos;
@using EMRSimulationWebApp.Controllers;
@model ModuleRepositoryViewModel

@{
    ViewData["Title"] = "Module Repository";

    // Students browse and open; only supervisors create, copy, rename or delete.
    // Defaults to false so a missing flag fails closed.
    var canManage = ViewData["CanManage"] as bool? ?? false;
}

<div class="form-group row mb-2" style="background-color: black; color: white;">
    <div class="col-sm-12">
        <label class="col-form-label">GLOBAL MODULE REPOSITORY</label>
    </div>
</div>

<p class="text-muted small">
    @if (canManage)
    {
        <text>
            Modules are shared across all campuses. Creating or editing a module here makes it
            available to every Supervisor login.
        </text>
    }
    else
    {
        <text>Select your year level and module, then open it to view the scenario.</text>
    }
</p>

<!-- filters -->
<div class="row g-2 align-items-end mb-3">
    <div class="col-sm-3">
        <label class="form-label small mb-1">Year Level</label>
        <select id="filterYearLevel" class="form-control form-control-sm">
            <option value="0">All year levels</option>
            @foreach (var y in Model.YearLevels)
            {
                <option value="@y.Id" selected="@(y.Id == Model.SelectedYearLevelId)">@y.YearLevelName</option>
            }
        </select>
    </div>
    <div class="col-sm-3">
        <label class="form-label small mb-1">Unit</label>
        <select id="filterUnit" class="form-control form-control-sm">
            <option value="0">All units</option>
            @foreach (var u in Model.Units)
            {
                <option value="@u.Id" selected="@(u.Id == Model.SelectedUnitId)">
                    @(string.IsNullOrWhiteSpace(u.UnitCode) ? u.UnitName : $"{u.UnitCode} - {u.UnitName}")
                </option>
            }
        </select>
    </div>
    <div class="col-sm-3">
        <label class="form-label small mb-1">Search</label>
        <input type="text" id="filterSearch" class="form-control form-control-sm"
               placeholder="Module or unit name" value="@Model.SearchTerm" />
    </div>
    <div class="col-sm-3 text-end">
        @if (canManage)
        {
            <a href="javascript:void(0);" id="btnNewModule" class="btn btn-primary btn-sm"
               style="background-color:#FF8A30;">New Module</a>
        }
    </div>
</div>

<div id="moduleListArea">
    @await Html.PartialAsync("~/Views/Patient/_moduleList.cshtml", Model.Modules)
</div>

<div class="mt-2"><label id="lblModuleMessage" style="color:green"></label></div>

@if (canManage)
{
<!-- ===================== New / Copy / Rename modal ===================== -->
<div class="modal fade" id="moduleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="moduleModalTitle">New Module</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="moduleModalMode" value="new" />
                <input type="hidden" id="moduleModalSourceId" value="0" />

                <div class="mb-2">
                    <label class="form-label small">Module name</label>
                    <input type="text" id="moduleName" class="form-control" maxlength="150"
                           placeholder="e.g. Week 2 - Post-operative care" />
                </div>

                <div class="mb-2" id="moduleUnitWrapper">
                    <label class="form-label small">Unit</label>
                    <select id="moduleUnit" class="form-control">
                        @foreach (var u in Model.Units)
                        {
                            <option value="@u.Id">
                                @(string.IsNullOrWhiteSpace(u.UnitCode) ? u.UnitName : $"{u.UnitCode} - {u.UnitName}")
                            </option>
                        }
                    </select>
                    <div class="form-text" id="moduleUnitHelp"></div>
                </div>

                <div class="mb-2">
                    <label class="form-label small">Description (optional)</label>
                    <textarea id="moduleDescription" class="form-control" rows="2" maxlength="500"></textarea>
                </div>

                <div class="alert alert-secondary small mb-0" id="moduleModalHint"></div>
                <div class="text-danger small mt-2" id="moduleModalError"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="btnSaveModule"
                        style="background-color:#FF8A30;">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- ===================== Delete confirmation modal ===================== -->
<div class="modal fade" id="deleteModuleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Module Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="deleteModuleId" value="0" />
                <p>
                    Delete <strong id="deleteModuleName"></strong>?
                </p>
                <p class="text-danger small mb-0">
                    This permanently removes the module, its patients and every chart belonging
                    to them. Other modules are unaffected. This cannot be undone.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="btnConfirmDeleteModule">Delete Module</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="loadIntoLabModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="loadIntoLabTitle">Load Module Into Labs</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="loadModuleId" value="0" />
                <p class="mb-2">
                    Load <strong id="loadModuleName"></strong> into the labs ticked below.
                </p>
                <p class="small text-muted mb-3">
                    The patient and every chart are copied into each lab exactly as prepared.
                    Students see the patient in their normal patient list. The module itself is
                    not changed.
                </p>

                <div id="loadLabList" class="border rounded p-2" style="max-height:260px; overflow-y:auto;">
                    <div class="text-muted small">Loading labs...</div>
                </div>

                <p class="text-danger small mb-0 mt-3 d-none" id="loadReplaceWarning">
                    Labs marked <strong>already loaded</strong> will have their existing copy
                    replaced, permanently deleting anything students have written into it. This
                    is how a scenario is reset between classes, and it cannot be undone.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="btnConfirmLoadIntoLab">Load Into Labs</button>
            </div>
        </div>
    </div>
</div>
}

<script>
(function () {

    // This partial is re-injected into #content-area every time the menu item is
    // clicked, which re-runs this script. Delegated handlers live on `document`,
    // which outlives the partial, so without this they accumulate: one click then
    // fires N handlers, opens N modals, creates N backdrops but only closes one,
    // and the leftover backdrop silently swallows every subsequent click.
    // Namespacing lets us drop the previous bindings before adding fresh ones.
    $(document).off('.modrepo');

    // Bootstrap keeps one instance per element; reuse it rather than constructing
    // a new one on every open, which would orphan the previous instance.
    function showModal(id) {
        return bootstrap.Modal.getOrCreateInstance(document.getElementById(id)).show();
    }

    function hideModal(id) {
        var inst = bootstrap.Modal.getInstance(document.getElementById(id));
        if (inst) inst.hide();
    }

    // Belt and braces: if a backdrop is ever left behind the whole page becomes
    // unclickable, so sweep up any strays once the modal has finished hiding.
    $(document).on('hidden.bs.modal.modrepo', '.modal', function () {
        if (!document.querySelector('.modal.show')) {
            document.querySelectorAll('.modal-backdrop').forEach(function (b) { b.remove(); });
            document.body.classList.remove('modal-open');
            document.body.style.overflow = '';
            document.body.style.paddingRight = '';
        }
    });

    function currentFilters() {
        return {
            yearLevelId: $('#filterYearLevel').val() || 0,
            unitId: $('#filterUnit').val() || 0,
            searchTerm: $('#filterSearch').val() || ''
        };
    }

    function refreshList(message) {
        $.ajax({
            url: '/module/getmodulelist',
            method: 'GET',
            data: currentFilters(),
            success: function (html) {
                $('#moduleListArea').html(html);
                if (message) $('#lblModuleMessage').text(message).css('color', 'green');
            },
            error: function (xhr) {
                $('#lblModuleMessage').text('Could not refresh the module list.').css('color', 'red');
                console.error('refreshList failed:', xhr.status, xhr.responseText);
            }
        });
    }

    // ---- filters -------------------------------------------------------
    $('#filterYearLevel').on('change', function () {
        var yearLevelId = $(this).val();

        // repopulate units for the chosen year level, then refresh
        $.ajax({
            url: '/module/getunits',
            method: 'GET',
            data: { yearLevelId: yearLevelId },
            success: function (units) {
                var $unit = $('#filterUnit').empty().append('<option value="0">All units</option>');
                var $modalUnit = $('#moduleUnit').empty();
                $.each(units, function (i, u) {
                    $unit.append($('<option>').val(u.id).text(u.name));
                    $modalUnit.append($('<option>').val(u.id).text(u.name));
                });
                refreshList();
            },
            error: function () { refreshList(); }
        });
    });

    $('#filterUnit').on('change', function () { refreshList(); });

    var searchTimer = null;
    $('#filterSearch').on('keyup', function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(function () { refreshList(); }, 350);
    });

    // ---- new module ----------------------------------------------------
    $('#btnNewModule').on('click', function () {
        $('#moduleModalMode').val('new');
        $('#moduleModalSourceId').val(0);
        $('#moduleModalTitle').text('New Module');
        $('#moduleName').val('');
        $('#moduleDescription').val('');
        $('#moduleUnitWrapper').show();
        $('#moduleUnitHelp').text('');
        $('#moduleModalHint').text(
            'Creates an empty module with the full EMR structure ready to populate. ' +
            'A blank patient record is created automatically.');
        $('#moduleModalError').text('');
        showModal('moduleModal');
    });

    // ---- copy module ---------------------------------------------------
    $(document).on('click.modrepo', '.copyModule', function () {
        var row = $(this).closest('tr');
        $('#moduleModalMode').val('copy');
        $('#moduleModalSourceId').val(row.data('module-id'));
        $('#moduleModalTitle').text('Copy Module');
        $('#moduleName').val(row.data('module-name') + ' (copy)');
        $('#moduleDescription').val('');
        $('#moduleUnitWrapper').show();
        $('#moduleUnit').val(row.data('unit-id'));
        $('#moduleUnitHelp').text('Choose a different unit to reuse this scenario elsewhere.');
        $('#moduleModalHint').text(
            'Copies the patient and every chart from the source module. ' +
            'The original is left untouched.');
        $('#moduleModalError').text('');
        showModal('moduleModal');
    });

    // ---- rename module -------------------------------------------------
    $(document).on('click.modrepo', '.renameModule', function () {
        var row = $(this).closest('tr');
        $('#moduleModalMode').val('rename');
        $('#moduleModalSourceId').val(row.data('module-id'));
        $('#moduleModalTitle').text('Rename Module');
        $('#moduleName').val(row.data('module-name'));
        $('#moduleDescription').val('');
        $('#moduleUnitWrapper').hide();
        $('#moduleModalHint').text(
            'Leave the description blank to keep the existing one.');
        $('#moduleModalError').text('');
        showModal('moduleModal');
    });

    // ---- save (handles all three modes) --------------------------------
    $('#btnSaveModule').on('click', function () {
        var mode = $('#moduleModalMode').val();
        var name = ($('#moduleName').val() || '').trim();
        var desc = ($('#moduleDescription').val() || '').trim();
        var unitId = parseInt($('#moduleUnit').val(), 10) || 0;
        var sourceId = parseInt($('#moduleModalSourceId').val(), 10) || 0;

        if (!name) { $('#moduleModalError').text('Module name is required.'); return; }
        if (mode !== 'rename' && unitId <= 0) {
            $('#moduleModalError').text('Please select a unit.'); return;
        }

        var url, payload;
        if (mode === 'new') {
            url = '/module/addmodule';
            payload = { Id: 0, UnitId: unitId, ModuleName: name, Description: desc || null, SortOrder: 0, Active: true };
        } else if (mode === 'copy') {
            url = '/module/copymodule';
            payload = { SourceModuleId: sourceId, NewModuleName: name, TargetUnitId: unitId, Description: desc || null };
        } else {
            url = '/module/renamemodule';
            // null description means "leave the existing one alone"
            payload = { ModuleId: sourceId, NewName: name, Description: desc || null };
        }

        $.ajax({
            type: 'POST',
            url: url,
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function (response) {
                hideModal('moduleModal');
                refreshList(response.resultMessage);
            },
            error: function (xhr) {
                $('#moduleModalError').text(xhr.responseText || 'The module could not be saved.');
            }
        });
    });

    // ---- open module (load its patients) -------------------------------
    $(document).on('click.modrepo', '.openModule', function () {
        var moduleId = $(this).attr('data-custom');

        // Module patients are not lab-scoped; clear the lab context so the
        // chart screens fall into module mode (labId 0).
        $('#txtLabId').val(0);
        $('#txtPatientId').val('');

        $.ajax({
            url: '/module/getmodulepatients',
            method: 'GET',
            data: { moduleId: moduleId },
            success: function (html) {
                $('#content-area').html(html);
            },
            error: function (xhr) {
                $('#lblModuleMessage').text('Could not open the module.').css('color', 'red');
                console.error('openModule failed:', xhr.status, xhr.responseText);
            }
        });
    });

    // ---- load a module into one or more labs ---------------------------
    // The target labs come from this picker rather than the caller's own login,
    // because academics prepare a scenario once and push it to every campus.
    $(document).on('click.modrepo', '.loadIntoLab', function () {
        var row = $(this).closest('tr');
        var moduleId = row.data('module-id');

        $('#loadModuleId').val(moduleId);
        $('#loadModuleName').text(row.data('module-name'));
        $('#loadReplaceWarning').addClass('d-none');
        $('#loadLabList').html('<div class="text-muted small">Loading labs...</div>');
        showModal('loadIntoLabModal');

        $.ajax({
            url: '/module/getloadtargets',
            method: 'GET',
            data: { moduleId: moduleId },
            success: function (labs) {
                if (!labs || !labs.length) {
                    $('#loadLabList').html('<div class="text-danger small">No active labs were found.</div>');
                    return;
                }

                var html = labs.map(function (l) {
                    var when = l.loadedAt ? new Date(l.loadedAt) : null;
                    var whenText = when
                        ? when.toLocaleDateString() + ' ' + when.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                        : '';

                    // Own lab ticked by default; other campuses are opt-in, so pushing
                    // a scenario across campuses is always a deliberate act.
                    var checked = l.isOwn ? ' checked' : '';
                    var note = l.loaded
                        ? '<span class="text-danger small"> - already loaded' + (whenText ? ' ' + whenText : '') + ', will be replaced</span>'
                        : '';
                    var own = l.isOwn ? '<span class="text-muted small"> - your lab</span>' : '';

                    return '<div class="form-check">' +
                           '<input class="form-check-input loadLabCheck" type="checkbox" value="' + l.labId +
                           '" id="lab_' + l.labId + '" data-loaded="' + (l.loaded ? '1' : '0') + '"' + checked + ' />' +
                           '<label class="form-check-label" for="lab_' + l.labId + '">' +
                           $('<div>').text(l.labName || ('Lab ' + l.labId)).html() + own + note +
                           '</label></div>';
                }).join('');

                $('#loadLabList').html(html);
                updateLoadWarning();
            },
            error: function (xhr) {
                $('#loadLabList').html('<div class="text-danger small">Could not load the lab list.</div>');
                console.error('getloadtargets failed:', xhr.status);
            }
        });
    });

    // The red warning only appears when a ticked lab would actually lose work.
    function updateLoadWarning() {
        var destructive = $('.loadLabCheck:checked').filter(function () {
            return $(this).data('loaded') === 1 || $(this).data('loaded') === '1';
        }).length;

        $('#loadReplaceWarning').toggleClass('d-none', destructive === 0);
        $('#btnConfirmLoadIntoLab').text(destructive > 0 ? 'Replace And Load' : 'Load Into Labs');
    }

    $(document).on('change.modrepo', '.loadLabCheck', updateLoadWarning);

    $(document).on('click.modrepo', '#btnConfirmLoadIntoLab', function () {
        var btn = $(this);
        var moduleId = parseInt($('#loadModuleId').val()) || 0;
        if (moduleId <= 0) return;

        var labIds = $('.loadLabCheck:checked').map(function () {
            return parseInt(this.value);
        }).get();

        if (!labIds.length) {
            $('#loadLabList').before('<div class="text-danger small mb-2" id="noLabPicked">Choose at least one lab.</div>');
            setTimeout(function () { $('#noLabPicked').remove(); }, 2500);
            return;
        }

        // Copying every chart is not instant, and a second click would run the
        // whole load again, replacing the copy the first click had just made.
        var label = btn.text();
        btn.prop('disabled', true).text('Loading...');

        $.ajax({
            url: '/module/loadintolab',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ ModuleId: moduleId, LabIds: labIds }),
            success: function (response) {
                hideModal('loadIntoLabModal');
                refreshList(response.resultMessage);
            },
            error: function (xhr) {
                hideModal('loadIntoLabModal');
                $('#lblModuleMessage')
                    .text(xhr.responseText || 'The module could not be loaded.')
                    .css('color', 'red');
            },
            complete: function () {
                btn.prop('disabled', false).text(label);
            }
        });
    });

    // ---- delete module -------------------------------------------------
    $(document).on('click.modrepo', '.deleteModule', function () {
        var row = $(this).closest('tr');
        $('#deleteModuleId').val(row.data('module-id'));
        $('#deleteModuleName').text(row.data('module-name'));
        showModal('deleteModuleModal');
    });

    $('#btnConfirmDeleteModule').on('click', function () {
        var moduleId = $('#deleteModuleId').val();

        $.ajax({
            url: '/module/deletemodule',
            method: 'GET',
            data: { moduleId: moduleId },
            success: function (cleared) {
                hideModal('deleteModuleModal');
                var total = 0;
                $.each(cleared, function (i, c) { total += c.rowsDeleted; });
                refreshList('Module deleted (' + total + ' row(s) removed).');
            },
            error: function (xhr) {
                $('#lblModuleMessage').text('The module could not be deleted.').css('color', 'red');
                console.error('deleteModule failed:', xhr.status, xhr.responseText);
            }
        });
    });

})();
</script>
