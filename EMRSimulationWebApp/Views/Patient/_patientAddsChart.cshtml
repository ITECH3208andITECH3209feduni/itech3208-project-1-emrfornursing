$('.data-label').on('click', function() {
        const labelName = $(this).text();
        const data = modalData.find(item => item.name === labelName);

        // Clear previous table data
        $('#data-table-body').empty();

        // Populate table with the selected data
        if (data) {
            for (const zone in data.range) {
                const rangeValue = data.range[zone];
                const actionValue = data.actions[zone];
                
                // Determine the appropriate class for the zone
                let zoneClass = '';
                switch (zone) {
                    case 'Purple Zone':
                        zoneClass = 'purple-zone';
                        break;
                    case 'Orange Zone':
                        zoneClass = 'orange-zone';
                        break;
                    case 'Light Orange Zone':
                        zoneClass = 'light-orange-zone';
                        break;
                    case 'Yellow Zone':
                        zoneClass = 'yellow-zone';
                        break;
                    case 'White Zone':
                        zoneClass = 'white-zone';
                        break;
                }

                $('#data-table-body').append(`
                    <tr class="${zoneClass}">
                        <td style='align-content: center; width:50%; height:64px;'>${rangeValue}</td>
                        <td style='align-content: center;''>${actionValue}</td>
                    </tr>
                `);
            }
        }
    });

        
        $(".lbladds-scores").on("click", function () { 
            alert();
        });


        /* ------------------------------------------------------------------
           ADDS colour coding

           The client asked for the score cells to be shaded, not just totalled.
           Every dropdown option already carries its ADDS zone in data-color, so
           each vital sign is coloured from the option the user picked - the
           colours come from the chart itself rather than a second mapping that
           could drift from it.

           Purple needs white text to stay readable; the other four zones are
           light enough for black.
           ------------------------------------------------------------------ */
        var ADDS_PURPLE = '#A020F0';

        function paintScore(selector, score, color) {
            var cell = $(selector);
            cell.html(score);

            if (!color || score === '' || score === null || typeof score === 'undefined') {
                cell.css({ 'background-color': '', 'color': '' });
                return;
            }

            cell.css({
                'background-color': color,
                'color': color.toUpperCase() === ADDS_PURPLE ? '#FFFFFF' : '#000000'
            });
        }

        /* Total ADDS bands, from the escalation table on the chart:
           0 routine, 1-3 inform senior nurse, 4-5 nurse or junior MO review,
           6-7 senior MO review, 8+ emergency call. Shaded with the same five
           zones so the total reads consistently with the rows above it. */
        function totalZoneColour(total) {
            if (total >= 8) return ADDS_PURPLE;   /* emergency call */
            if (total >= 6) return '#FFA500';     /* orange */
            if (total >= 4) return '#FFDBBB';     /* light orange */
            if (total >= 1) return '#FFFF00';     /* yellow */
            return '#FFFFFF';                     /* white - routine */
        }

        var RespiratoryAlert = 0;
        var OxygenSaturationAlert = 0;
        var BloodPressureAlert = 0;
        var HeartRateAlert = 0;
        var ConsciousnessAlert = 0;
    
        document.getElementById('ddlRespiratory').addEventListener('change', function() {
            var selectedOption = this.options[this.selectedIndex];
            var color = selectedOption.getAttribute('data-color');
            var score = selectedOption.getAttribute('data-score');

            if ($('#ddlRespiratory').val().indexOf("Write") !== -1) {
                $("#txtRespiratoryRateValue").show();
            }
            else {
                $("#txtRespiratoryRateValue").val("");
                $("#txtRespiratoryRateValue").hide();
            }

            // Change the background color of the color box
            document.getElementById('colorBoxRespiratory').style.backgroundColor = color;
            paintScore(".respiratoryscore", score, color);
            updateTotalScore();
        });

        document.getElementById('ddlRespiratory').dispatchEvent(new Event('change'));

        document.getElementById('ddlO2Sat').addEventListener('change', function () {
            var selectedOption = this.options[this.selectedIndex];
            var color = selectedOption.getAttribute('data-color');
            var score = selectedOption.getAttribute('data-score');

            if ($('#ddlO2Sat').val().indexOf("Write") !== -1) {
                $("#txtOxygenSaturationValue").show();
            }
            else {
                $("#txtOxygenSaturationValue").val("");
                $("#txtOxygenSaturationValue").hide();
            }

            // Change the background color of the color box
            document.getElementById('colorBoxO2Sat').style.backgroundColor = color;
            paintScore(".saturationscore", score, color);
            updateTotalScore();
        });

        document.getElementById('ddlO2Sat').dispatchEvent(new Event('change'));

        document.getElementById('ddlO2Flow').addEventListener('change', function () {
            var selectedOption = this.options[this.selectedIndex];
            var color = selectedOption.getAttribute('data-color');
            var score = selectedOption.getAttribute('data-score');

            // Change the background color of the color box
            document.getElementById('colorBoxO2Flow').style.backgroundColor = color;
            paintScore(".flowratescore", score, color);
            updateTotalScore();
        });

        document.getElementById('ddlO2Flow').dispatchEvent(new Event('change'));

        // N/A means no supplemental oxygen was running, so there is no flow rate to
        // record. The dropdown is cleared and disabled rather than hidden, so it is
        // obvious why it cannot be used. An unrecorded rate scores 0 either way.
        $('#chkO2FlowNA').on('change', function () {
            var na = this.checked;

            $('#ddlO2Flow').prop('disabled', na);

            if (na) {
                $('#ddlO2Flow').val("");
                document.getElementById('colorBoxO2Flow').style.backgroundColor = "#FFFFFF";
                paintScore(".flowratescore", "0", "#FFFFFF");
                updateTotalScore();
            } else {
                document.getElementById('ddlO2Flow').dispatchEvent(new Event('change'));
            }
        });

