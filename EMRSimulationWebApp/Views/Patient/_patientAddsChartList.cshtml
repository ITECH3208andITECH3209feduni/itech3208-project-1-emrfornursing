@{
    ViewData["Title"] = "Patient List";
}
@using EMRSimulation.Domain.Dtos;
@using EMRSimulation.Domain.Clinical;
@using System.Globalization
@model PatientAddsListViewModel

@*
    Observation cells are shaded to their ADDS zone, the same colours the entry
    form uses. The entry form reads the zone from the data-color attribute on the
    option the user picked; this screen only has the stored text, so it looks the
    colour up in AddsZones, which was generated from those same options.

    Mode of delivery and diastolic blood pressure are never shaded - neither is
    scored by ADDS.
*@
@functions {
    static string Zone(string field, string value)
    {
        var colour = AddsZones.ColourFor(field, value);
        return $"background-color:{colour};color:{AddsZones.TextColourFor(colour)}";
    }
}

<style>
    /* Zone colours are set inline per cell, because they depend on the stored value. */
    #patientsAddsTable td {
        vertical-align: middle;
    }

    .adds-total-badge {
        display: inline-block;
        min-width: 2.2rem;
        padding: 0.15rem 0.5rem;
        border: 1px solid rgba(0, 0, 0, 0.35);
        border-radius: 0.75rem;
        font-weight: 600;
        text-align: center;
    }

    /* The zone colours carry the meaning, so give the legend the same swatches
       rather than describing them in words only. */
    .adds-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
        margin: 0.75rem 0;
        font-size: 0.85rem;
    }

    .adds-legend span {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }

    .adds-legend i {
        width: 0.9rem;
        height: 0.9rem;
        border: 1px solid rgba(0, 0, 0, 0.35);
        display: inline-block;
    }
</style>

<div class="adds-legend">
    <strong>ADDS zones:</strong>
    <span><i style="background-color:@AddsZones.White"></i> 0 &ndash; routine</span>
    <span><i style="background-color:@AddsZones.Yellow"></i> 1&ndash;3</span>
    <span><i style="background-color:@AddsZones.LightOrange"></i> 4&ndash;5</span>
    <span><i style="background-color:@AddsZones.Orange"></i> 6&ndash;7</span>
    <span><i style="background-color:@AddsZones.Purple"></i> 8+ &ndash; emergency call</span>
</div>

<div class="text-left">
    <table id="patientsAddsTable" class="display">
        <thead>
            <tr>
                <th>Patient ID</th>
                <th>Entered Date</th>
                <th>Entered Time</th>
                <th>Respiratory Rate</th>
                <th>OxygenSaturation</th>
                <th>OxygenFlow</th>
                <th>Mode of Delivery</th>
                <th>Blood Pressure Systolic</th>
                <th>Blood Pressure Diastolic</th>
                <th>Heart Rate</th>
                <th>Temperature</th>
                <th>Consciousness</th>
                <th>Total ADDS</th>

                @* Delete is available to both roles now. A supervisor preparing a module
                   who mistypes an observation previously had no way to remove it. *@
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var patient in Model.AddsDtoList)
            {
                string enteredTime = patient.EnteredTime;
                if (DateTime.TryParseExact(
                    patient.EnteredTime,
                    new[] { "HH:mm", "H:mm", "hh:mm tt", "h:mm tt" },
                    CultureInfo.InvariantCulture,
                    DateTimeStyles.None,
                    out var t))
                {
                    enteredTime = t.ToString("hh:mm tt");
                }
                <tr>
                    <td>@patient.Id</td>
                    <td>@(patient.EnteredDate?.ToString("dd-MMM-yyyy"))</td>
                    <td>@patient.EnteredTime</td>
                    @if (patient.RespiratoryRate.Contains("Write"))
                    {
                        <td style="@Zone(AddsZones.RespiratoryRate, patient.RespiratoryRate)">@patient.RespiratoryRate: (@patient.RespiratoryRateValue)</td>
                    }
                    else
                    {
                        <td style="@Zone(AddsZones.RespiratoryRate, patient.RespiratoryRate)">@patient.RespiratoryRate</td>
                    }

                    @if (patient.OxygenSaturation.Contains("Write"))
                    {
                        <td style="@Zone(AddsZones.OxygenSaturation, patient.OxygenSaturation)">@patient.OxygenSaturation: (@patient.OxygenSaturationValue)</td>
                    }
                    else
                    {
                        <td style="@Zone(AddsZones.OxygenSaturation, patient.OxygenSaturation)">@patient.OxygenSaturation</td>
                    }

                    <td style="@Zone(AddsZones.OxygenFlow, patient.OxygenFlow)">@patient.OxygenFlow</td>

                    @* Observations recorded before Sprint 3 have no mode of delivery. *@
                    <td>@(string.IsNullOrEmpty(patient.ModeOfDelivery) ? "-" : patient.ModeOfDelivery)</td>

                    @if (patient.BloodPressure.Contains("Write"))
                    {
                        <td style="@Zone(AddsZones.BloodPressure, patient.BloodPressure)">@patient.BloodPressure: (@patient.BloodPressureValue)</td>
                    }
                    else
                    {
                        <td style="@Zone(AddsZones.BloodPressure, patient.BloodPressure)">@patient.BloodPressure</td>
                    }

                    @if (patient.BloodPressureDiastolic.Contains("Write"))
                    {
                        <td>@patient.BloodPressureDiastolic: (@patient.BloodPressureDiastolicValue)</td>
                    }
                    else
                    {
                        <td>@patient.BloodPressureDiastolic</td>
                    }

                    @if (patient.HeartRate.Contains("Write"))
                    {
                        <td style="@Zone(AddsZones.HeartRate, patient.HeartRate)">@patient.HeartRate: (@patient.HeartRateValue)</td>
                    }
                    else
                    {
                        <td style="@Zone(AddsZones.HeartRate, patient.HeartRate)">@patient.HeartRate</td>
                    }

                    @if (patient.Temperature.Contains("Write"))
                    {
                        <td style="@Zone(AddsZones.Temperature, patient.Temperature)">@patient.Temperature: (@patient.TemperatureValue)</td>
                    }
                    else
                    {
                        <td style="@Zone(AddsZones.Temperature, patient.Temperature)">@patient.Temperature</td>
                    }

                    <td style="@Zone(AddsZones.Consciousness, patient.Consciousness)">@patient.Consciousness</td>
                    <td>
                        @{
                            var total       = patient.TotalScore ?? 0;
                            var totalColour = AddsZones.TotalColour(total);
                            var totalText   = AddsZones.TextColourFor(totalColour);
                            var totalTitle  = total >= 8
                                ? "Emergency call threshold"
                                : "ADDS total";
                        }
                        <span class="adds-total-badge"
                              style="background-color:@totalColour;color:@totalText"
                              title="@totalTitle">@total</span>
                    </td>

                    <td>
                        <a href="javascript:void(0);" class="btn btn-danger btn-sm deleteAdds"
                           data-custom="@patient.Id"
                           data-when="@(patient.EnteredDate?.ToString("dd-MMM-yyyy")) @patient.EnteredTime">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div>
    <label id="lblMessage" style="color:green"></label>

    @*
    @if (User.HasClaim(c => c.Value == "student"))
    {
    *@
        <button type="button" id="btnAddAddsChart" class="btn btn-primary" style="background-color:#FF8A30;float: left;">Add ADDS</button>
    @*
    }
    *@
</div>

<script>
    $(document).ready(function () {
        var table = $('#patientsAddsTable').DataTable({
            "paging": true, // Remove paging control
            "info": false, // Remove "Showing 1 to X" information
            "searching": false, // Remove search box
            "ordering": true, // Enable column ordering (if needed)
            "autoWidth": false, // Prevent auto width
            "lengthChange": false,  // Hide the entries per page dropdown
            // "pageLength": 3,  // Set the default number of entries per page (optional)
            "columnDefs": [
                {
                    "targets": [0],
                    "visible": false
                } // Disable sorting for the action column
            ]
        });

        var LabId = $('#txtLabId').val();
        var PatientId = $('#txtPatientId').val();

        $('#btnAddAddsChart').on('click', function (e) {
            e.preventDefault(); // Prevent default link behavior

            // Get the URL from the data-url attribute
            var pageUrl = "/patient/getpatientadds";

            // Use AJAX to load the content from the URL
            $.ajax({
                url: pageUrl,
                method: "GET",
                data: { labId: LabId, patientId: PatientId },
                success: function (response) {
                    // Load the response into the right-side content area
                    $('#content-area').html("");
                    $('#content-area').html(response);
                },
                error: function (xhr, status, error) {
                    console.error("Error loading the page:", error);
                }
            });
        });

        $('#patientsAddsTable').on('click', '.deleteAdds', function() {

            var addsId = $(this).attr("data-custom");
            var when = $(this).attr("data-when") || "this observation";

            if (!window.confirm("Delete the ADDS observation recorded on " + when + "?\n\nThis cannot be undone.")) {
                return;
            }

            $.ajax({
                type: "GET",
                url: "/patient/deletepatientadds",
                contentType: "application/json",
                data: { Id: addsId },
                success: function (response) {
                    if (response > 0) {
                        // Inline message rather than alert(). A native alert blocks the
                        // whole tab until dismissed, and nothing else in the app uses one.
                        $('#lblMessage').text("ADDS observation deleted.").css('color', 'green');

                        $.ajax({
                            url: "/patient/getpatientaddslist",
                            method: "GET",
                            data: { labId: LabId, patientId: PatientId },
                            success: function (response) {
                                // Load the response into the right-side content area
                                $('#content-area').html("");
                                $('#content-area').html(response);
                            },
                            error: function (xhr, status, error) {
                                console.error("Error loading the page:", error);
                            }
                        });

                    } else {
                        $('#lblMessage').text("Error").css('color', 'red');
                    }


                    console.log("Success:", response);
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.log("Error:", textStatus);
                }
            });
        });
    });


</script>
