@{
    ViewData["Title"] = "Patient List";
}
@using EMRSimulation.Domain.Dtos;
@model IEnumerable<ProgressNotesDto>

<div class="form-group row mb-1" style="background-color: black;color: white;">
    <div class="col-sm-7">
        <label class="col-sm-5 col-form-label">PROGRESS NOTES</label>
    </div>
</div>
@* Search and sort, as in the wireframe. The sort control is explicit rather than relying
   on the column header, because the header sorts the formatted date text. *@
<div class="row mb-2 mt-2">
    <div class="col-sm-6">
        <input type="text" id="txtNoteSearch" class="form-control" placeholder="Search notes.." autocomplete="off" />
    </div>
    <div class="col-sm-3 offset-sm-3">
        <select id="ddlNoteSort" class="form-select">
            <option value="desc">Sort : Newest first</option>
            <option value="asc">Sort : Oldest first</option>
        </select>
    </div>
</div>

<div class="text-left">
    <table id="patientsProgressNoteTable" class="display">
        <thead>
            <tr>
                <th>ID</th>
                <th>Notes</th>
                <th>&nbsp;</th>
                <th>Sign</th>
                <th>Date</th>
                <th>Time</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var patient in Model)
            {
                <tr>
                    <td>@patient.Id</td>
                    @* data-search gives the search the whole note. Without it only the
                       70 character preview below is indexed, so a word later in a long
                       note would not be found. *@
                    <td data-search="@patient.Notes">
                        @if (!string.IsNullOrEmpty(patient.Notes) && patient.Notes.Length > 50)
                        {
                            <span class="truncated-text">@patient.Notes.Substring(0, 70)...</span>                            
                        }
                        else
                        {
                            <span>@patient.Notes</span>
                        }
                    </td>
                    <td><a href="#" class="read-more" data-bs-toggle="modal" data-bs-target="#notesModal" data-fulltext="@patient.Notes">Read More</a></td>
                    <td>@patient.Sign</td>
                    @* The recorded date and time, shown separately as in the wireframe.
                       Notes saved before Sprint 3 may have no date at all.
                       data-order carries a sortable form, because "29-Jul-2026" sorts
                       alphabetically and would put April before January. *@
                    <td data-order="@(patient.NotesDate?.ToString("yyyyMMddHHmm") ?? "0")">@(patient.NotesDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                    <td>@(patient.NotesDate?.ToString("HH:mm") ?? "-")</td>

                    <td>
                    @if (User.HasClaim(c => c.Value == "student"))
                    {
                        @* Naomi: delete removed from the student login, edit enabled.
                           Students may still correct their own notes, not anyone else's. *@
                        if (patient.NotesFrom == "student")
                        {
                            <a href="javascript:void(0);" class="btn btn-primary editProgressNote" data-custom="@patient.Id" style="background-color:#FF8A30;">Edit</a>
                        }
                    }
                    else if (User.HasClaim(c => c.Value == "supervisor"))
                    {
                        if (patient.NotesFrom == "supervisor" || string.IsNullOrEmpty(patient.NotesFrom))
                        {
                            <a href="javascript:void(0);" class="btn btn-primary editProgressNote" data-custom="@patient.Id" style="background-color:#FF8A30;">Edit</a>
                            <a href="javascript:void(0);" class="btn btn-primary deleteProgressNote" data-custom="@patient.Id" style="background-color:#FF8A30;">Delete</a>
                        }
                    }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div>
    <label id="lblMessage" style="color:green"></label>
</div>

<div class="modal fade" id="notesModal" tabindex="-1" role="dialog" aria-labelledby="notesModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="notesModalLabel">Full Notes</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="word-wrap: break-word; white-space: pre-line;">
                <!-- Full text will be dynamically added here -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" style="background-color:black" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    var LabId = null;
    var PatientId = null;

    $(document).ready(function () {
        // Column 4 is the recorded date, sorted on its data-order value. Searching is on
        // but DataTables' own search box is suppressed, because the wireframe places the
        // field above the table alongside the sort control.
        var table = $('#patientsProgressNoteTable').DataTable({
            "paging": true, // Remove paging control
            "info": false, // Remove "Showing 1 to X" information
            "searching": true,
            // DataTables 2.x: 'layout' replaces the old 'dom' string. Clearing topEnd
            // removes the built-in search box, since ours sits above the table.
            "layout": {
                "topStart": null,
                "topEnd": null,
                "bottomStart": null,
                "bottomEnd": "paging"
            },
            "ordering": true,
            "order": [[4, "desc"]],
            "autoWidth": false, // Prevent auto width
            "lengthChange": false,  // Hide the entries per page dropdown
            // "pageLength": 3,  // Set the default number of entries per page (optional)
            "language": {
                "emptyTable": "No progress notes recorded for this patient.",
                "zeroRecords": "No notes match that search."
            },
            "columnDefs": [
                {
                    "targets": [0],
                    "visible": false
                },
                {
                    "targets": [1, 2, 3, 5, 6],
                    "orderable": false
                }
            ]
        });

        $('#txtNoteSearch').on('keyup', function () {
            table.search(this.value).draw();
        });

        $('#ddlNoteSort').on('change', function () {
            table.order([[4, this.value]]).draw();
        });

        $('#patientsProgressNoteTable').on('click', '.read-more', function() {
            var fullText = $(this).attr('data-fulltext');
            $('#notesModal .modal-body').text(fullText);
        });

        LabId = $('#txtLabId').val();
        PatientId = $('#txtPatientId').val();

        $('#patientsProgressNoteTable').on('click', '.editProgressNote', function () {

            var noteId = $(this).attr("data-custom");

            $.ajax({
                url: "/patient/getprogressnote",
                method: "GET",
                data: { id: noteId },
                success: function (response) {
                    $('#content-area').html("");
                    $('#content-area').html(response);
                },
                error: function (xhr, status, error) {
                    if (xhr.status === 403) {
                        $('#lblMessage').text("You can only edit notes written from your own login.").css('color', 'red');
                    } else {
                        $('#lblMessage').text("Could not open that note.").css('color', 'red');
                    }
                }
            });
        });

        $('#patientsProgressNoteTable').on('click', '.deleteProgressNote', function() {

            var addsId = $(this).attr("data-custom");

            $.ajax({
                type: "GET",
                url: "/patient/deleteprogressnote",
                contentType: "application/json",
                data: { Id: addsId }, // Wrap Id in an object
                success: function (response) {
                    if (response > 0) {

                        alert("Progress Note record deleted successfully")

                        $.ajax({
                            url: "/patient/GetProgressNoteList",
                            method: "GET",
                            data: { labId: LabId, patientId: PatientId }, // Wrap Id in an object
                            success: function (response) {
                                // Load the response into the right-side content area
                                $('#content-area').html("");
                                $('#content-area').html(response);
                            },
                            error: function (xhr, status, error) {
                                console.error("Error loading the page:", error);
                            }
                        });

                    } else {
                        $('#lblMessage').text("Error").css('color', 'red');
                    }
                

                    console.log("Success:", response);
                },
                error: function (jqXHR, textStatus, errorThrown) {
                    console.log("Error:", textStatus);
                }
            });
        });
    });
    

</script>
