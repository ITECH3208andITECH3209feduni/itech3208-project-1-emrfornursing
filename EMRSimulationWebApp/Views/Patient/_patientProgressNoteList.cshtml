@using EMRSimulation.Domain.Dtos
@model IEnumerable<ProgressNotesDto>

@{
    var notes = Model?.ToList() ?? new List<ProgressNotesDto>();
    var currentRole = User.HasClaim(c => c.Value == "supervisor")
        ? "supervisor"
        : "student";
}

<style>
    /* Layout is Kunal's approved two-panel design, unchanged. Colours, type and
       radii now come from the tokens in site.css so this screen matches the rest
       of the app instead of carrying its own palette. */

    #progressNotesPage {
        padding: var(--sp-5) var(--sp-3) var(--sp-5);
    }

    #progressNotesPage .progress-title {
        margin: 0 0 var(--sp-1);
        font-size: var(--fs-xl);
        font-weight: var(--fw-bold);
    }

    #progressNotesPage .progress-subtitle {
        margin: 0 0 var(--sp-5);
        color: var(--emr-text-muted);
        font-size: var(--fs-sm);
    }

    #progressNotesPage .progress-layout {
        display: grid;
        grid-template-columns: minmax(300px, 0.85fr) minmax(420px, 1.35fr);
        gap: 24px;
        align-items: start;
    }

    #progressNotesPage .progress-panel {
        border: 1px solid var(--emr-border);
        border-radius: var(--radius-md);
        background: var(--emr-surface);
        padding: 22px;
        box-shadow: var(--shadow-card);
    }

    #progressNotesPage .panel-title {
        margin: 0 0 var(--sp-5);
        font-size: var(--fs-lg);
        font-weight: var(--fw-medium);
    }

    #progressNotesPage .date-time-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    #progressNotesPage .field-group {
        margin-bottom: 17px;
    }

    #progressNotesPage .field-group label {
        display: block;
        margin-bottom: var(--sp-2);
        font-weight: var(--fw-medium);
        font-size: var(--fs-sm);
    }

    #progressNotesPage input,
    #progressNotesPage textarea,
    #progressNotesPage select {
        width: 100%;
        min-height: 42px;
        border: 1px solid var(--emr-border-strong);
        border-radius: var(--radius-sm);
        padding: var(--sp-2) var(--sp-3);
        background: var(--emr-surface);
        font-family: var(--font-base);
        font-size: var(--fs-md);
        color: var(--emr-text);
    }

    #progressNotesPage textarea {
        min-height: 190px;
        resize: vertical;
        white-space: pre-wrap;
        line-height: var(--lh-base);
    }

    #progressNotesPage .counter-row {
        margin-top: var(--sp-1);
        text-align: right;
        color: var(--emr-text-muted);
        font-size: var(--fs-sm);
    }

    #progressNotesPage .form-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: var(--sp-5);
    }

    /* Bootstrap .btn metrics, so these sit identically to buttons elsewhere. */
    #progressNotesPage .progress-btn {
        border: 1px solid transparent;
        border-radius: var(--radius-sm);
        padding: 6px 12px;
        cursor: pointer;
        font-size: var(--fs-md);
        line-height: var(--lh-base);
    }

    /* Orange primary, matching every other action button in the app. */
    #progressNotesPage .progress-btn-primary {
        background: var(--emr-orange);
        border-color: var(--emr-orange);
        color: var(--emr-on-orange);
    }

    #progressNotesPage .progress-btn-primary:hover,
    #progressNotesPage .progress-btn-primary:focus {
        background: var(--emr-orange-dark);
        border-color: var(--emr-orange-dark);
    }

    #progressNotesPage .progress-btn-secondary {
        background: var(--emr-surface);
        border-color: var(--emr-border-strong);
        color: var(--emr-text);
    }

    #progressNotesPage .history-tools {
        display: grid;
        grid-template-columns: minmax(220px, 1fr) 210px;
        gap: 18px;
        margin-bottom: 18px;
    }

    #progressNotesPage .history-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    #progressNotesPage .note-card {
        display: grid;
        grid-template-columns: 120px minmax(0, 1fr) auto;
        gap: 18px;
        align-items: start;
        border: 1px solid var(--emr-border);
        border-radius: var(--radius-md);
        padding: var(--sp-4);
        background: var(--emr-surface);
        box-shadow: var(--shadow-card);
    }

    #progressNotesPage .note-date {
        padding-right: 15px;
        border-right: 1px solid var(--emr-border);
        font-weight: var(--fw-medium);
        line-height: 1.35;
    }

    #progressNotesPage .note-time {
        display: block;
        margin-top: var(--sp-2);
        color: var(--emr-text-muted);
        font-weight: var(--fw-normal);
    }

    #progressNotesPage .note-text {
        margin: 0;
        overflow-wrap: anywhere;
        white-space: pre-wrap;
        line-height: var(--lh-base);
    }

    #progressNotesPage .note-meta {
        margin-top: var(--sp-2);
        color: var(--emr-text-muted);
        font-size: var(--fs-sm);
    }

    /* Same convention as the rest of the app: orange affirms, red destroys. */
    /* Bootstrap .btn-sm metrics. */
    #progressNotesPage .edit-note-btn
    #progressNotesPage .edit-note-btn {
        background: var(--emr-orange);
        border-color: var(--emr-orange);
        color: var(--emr-on-orange);
    }

    #progressNotesPage .edit-note-btn:hover,
    #progressNotesPage .edit-note-btn:focus {
        background: var(--emr-orange-dark);
        border-color: var(--emr-orange-dark);
    }

    #progressNotesPage .empty-history {
        border: 1px dashed var(--emr-border-strong);
        border-radius: var(--radius-md);
        padding: 26px;
        text-align: center;
        color: var(--emr-text-muted);
    }

    #progressNotesPage .progress-message {
        display: none;
        margin-top: 15px;
        padding: var(--sp-3);
        border: 1px solid transparent;
        border-radius: var(--radius-sm);
        font-size: var(--fs-sm);
    }

    #progressNotesPage .message-success {
        display: block;
        border-color: var(--emr-success-border);
        background: var(--emr-success-bg);
        color: var(--emr-success-text);
    }

    #progressNotesPage .message-error {
        display: block;
        border-color: var(--emr-error-border);
        background: var(--emr-error-bg);
        color: var(--emr-error-text);
    }

    @@media (max-width: 980px) {
        #progressNotesPage .progress-layout {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 650px) {
        #progressNotesPage .date-time-grid,
        #progressNotesPage .history-tools {
            grid-template-columns: 1fr;
        }

        #progressNotesPage .note-card {
            grid-template-columns: 1fr;
        }

        #progressNotesPage .note-date {
            border-right: 0;
            border-bottom: 1px solid var(--emr-border);
            padding: 0 0 10px;
        }
    }
</style>

<div id="progressNotesPage">
    <h2 class="progress-title">Progress Notes</h2>
    <p class="progress-subtitle">Create, edit and review patient progress notes.</p>

    <div class="progress-layout">
        <section class="progress-panel" aria-labelledby="progressNoteFormTitle">
            <h3 id="progressNoteFormTitle" class="panel-title">New Progress Note</h3>

            <input type="hidden" id="progressNoteId" value="0" />

            <div class="date-time-grid">
                <div class="field-group">
                    <label for="progressNoteDate">Date</label>
                    <input type="date" id="progressNoteDate" />
                </div>
                <div class="field-group">
                    <label for="progressNoteTime">Time</label>
                    <input type="time" id="progressNoteTime" />
                </div>
            </div>

            <div class="field-group">
                <label for="progressNoteText">Progress Note</label>
                <textarea id="progressNoteText" maxlength="2000" placeholder="Enter progress note..."></textarea>
                <div class="counter-row">
                    <span id="progressNoteCharacterCount">0</span> / 2000 characters
                </div>
            </div>

            <div class="field-group">
                <label for="progressNoteSign">Signature / Initials</label>
                <input type="text" id="progressNoteSign" maxlength="50" autocomplete="off" />
            </div>

            <div class="form-actions">
                <button type="button" id="saveProgressNoteButton" class="progress-btn progress-btn-primary">
                    Save Note
                </button>
                <button type="button" id="clearProgressNoteButton" class="progress-btn progress-btn-secondary">
                    Clear
                </button>
            </div>

            <div id="progressNoteMessage" class="progress-message" role="status" aria-live="polite"></div>
        </section>

        <section class="progress-panel" aria-labelledby="progressNoteHistoryTitle">
            <h3 id="progressNoteHistoryTitle" class="panel-title">Progress Note History</h3>

            <div class="history-tools">
                <div>
                    <label class="visually-hidden" for="progressNoteSearch">Search notes</label>
                    <input type="search" id="progressNoteSearch" placeholder="Search notes..." autocomplete="off" />
                </div>
                <div>
                    <label class="visually-hidden" for="progressNoteSort">Sort notes</label>
                    <select id="progressNoteSort">
                        <option value="newest">Sort: Newest first</option>
                        <option value="oldest">Sort: Oldest first</option>
                    </select>
                </div>
            </div>

            <div id="progressNoteHistoryList" class="history-list">
                @foreach (var note in notes)
                {
                    var noteDate = note.NotesDate;
                    var timestamp = noteDate.HasValue
                        ? new DateTimeOffset(noteDate.Value).ToUnixTimeSeconds()
                        : 0;
                    // Same role that wrote it. Notes saved before NotesFrom was recorded
                    // have no author, so only a supervisor may tidy those up.
                    var canEdit = string.Equals(note.NotesFrom, currentRole, StringComparison.OrdinalIgnoreCase)
                        || (currentRole == "supervisor" && string.IsNullOrWhiteSpace(note.NotesFrom));

                    <article class="note-card" data-note-timestamp="@timestamp" data-note-id="@note.Id">
                        <div class="note-date">
                            @if (noteDate.HasValue)
                            {
                                @noteDate.Value.ToString("dd MMMM yyyy")
                                <span class="note-time">@noteDate.Value.ToString("hh:mm tt")</span>
                            }
                            else
                            {
                                <span>Date unavailable</span>
                            }
                        </div>

                        <div class="note-content">
                            <p class="note-text">@note.Notes</p>
                            <div class="note-meta">
                                Signature: @note.Sign
                                @if (!string.IsNullOrWhiteSpace(note.NotesFrom))
                                {
                                    <span> | Entered by: @note.NotesFrom</span>
                                }
                            </div>

                            <textarea class="stored-note-text" hidden>@note.Notes</textarea>
                            <input class="stored-note-sign" type="hidden" value="@note.Sign" />
                            <input class="stored-note-date" type="hidden" value="@(noteDate?.ToString("yyyy-MM-dd") ?? string.Empty)" />
                            <input class="stored-note-time" type="hidden" value="@(noteDate?.ToString("HH:mm") ?? string.Empty)" />
                        </div>

                        <div>
                            @if (canEdit)
                            {
                                <button type="button" class="edit-note-btn">Edit</button>
                            }
                        </div>
                    </article>
                }

                @if (!notes.Any())
                {
                    <div id="progressNotesEmptyState" class="empty-history">
                        No progress notes have been saved for this patient.
                    </div>
                }
            </div>

            <div id="progressNotesNoSearchResults" class="empty-history" style="display:none; margin-top:16px;">
                No progress notes match your search.
            </div>
        </section>
    </div>

</div>

<script>
    (function () {
        const page = document.getElementById('progressNotesPage');
        if (!page) {
            return;
        }

        const idInput = page.querySelector('#progressNoteId');
        const dateInput = page.querySelector('#progressNoteDate');
        const timeInput = page.querySelector('#progressNoteTime');
        const noteInput = page.querySelector('#progressNoteText');
        const signInput = page.querySelector('#progressNoteSign');
        const countOutput = page.querySelector('#progressNoteCharacterCount');
        const saveButton = page.querySelector('#saveProgressNoteButton');
        const clearButton = page.querySelector('#clearProgressNoteButton');
        const message = page.querySelector('#progressNoteMessage');
        const formTitle = page.querySelector('#progressNoteFormTitle');
        const searchInput = page.querySelector('#progressNoteSearch');
        const sortInput = page.querySelector('#progressNoteSort');
        const historyList = page.querySelector('#progressNoteHistoryList');
        const noSearchResults = page.querySelector('#progressNotesNoSearchResults');

        function pad(value) {
            return String(value).padStart(2, '0');
        }

        function setCurrentDateTime() {
            const now = new Date();
            dateInput.value = [
                now.getFullYear(),
                pad(now.getMonth() + 1),
                pad(now.getDate())
            ].join('-');
            timeInput.value = pad(now.getHours()) + ':' + pad(now.getMinutes());
        }

        function updateCharacterCount() {
            countOutput.textContent = String(noteInput.value.length);
        }

        function showMessage(text, isSuccess) {
            message.textContent = text;
            message.className = isSuccess
                ? 'progress-message message-success'
                : 'progress-message message-error';
        }

        function clearMessage() {
            message.textContent = '';
            message.className = 'progress-message';
        }

        function resetForm() {
            idInput.value = '0';
            noteInput.value = '';
            signInput.value = '';
            formTitle.textContent = 'New Progress Note';
            saveButton.textContent = 'Save Note';
            setCurrentDateTime();
            updateCharacterCount();
            clearMessage();
        }

        function loadProgressNotesPage(successMessage) {
            const labId = Number.parseInt($('#txtLabId').val(), 10);
            const patientId = Number.parseInt($('#txtPatientId').val(), 10);

            $.ajax({
                url: '/patient/GetProgressNoteList',
                method: 'GET',
                data: { labId: labId, patientId: patientId },
                success: function (response) {
                    $('#content-area').html(response);
                    if (successMessage) {
                        const newMessage = document.querySelector('#progressNoteMessage');
                        if (newMessage) {
                            newMessage.textContent = successMessage;
                            newMessage.className = 'progress-message message-success';
                        }
                    }
                },
                error: function (xhr) {
                    showMessage(xhr.responseText || 'Unable to reload progress notes.', false);
                }
            });
        }

        function filterNotes() {
            const query = searchInput.value.trim().toLowerCase();
            const cards = Array.from(historyList.querySelectorAll('.note-card'));
            let visibleCount = 0;

            cards.forEach(function (card) {
                const searchableText = card.textContent.toLowerCase();
                const shouldShow = query === '' || searchableText.includes(query);
                card.style.display = shouldShow ? '' : 'none';
                if (shouldShow) {
                    visibleCount += 1;
                }
            });

            noSearchResults.style.display = cards.length > 0 && visibleCount === 0
                ? 'block'
                : 'none';
        }

        function sortNotes() {
            const cards = Array.from(historyList.querySelectorAll('.note-card'));
            const direction = sortInput.value === 'oldest' ? 1 : -1;

            cards.sort(function (first, second) {
                const firstTime = Number(first.dataset.noteTimestamp || 0);
                const secondTime = Number(second.dataset.noteTimestamp || 0);
                return (firstTime - secondTime) * direction;
            });

            cards.forEach(function (card) {
                historyList.appendChild(card);
            });

            filterNotes();
        }

        noteInput.addEventListener('input', updateCharacterCount);

        clearButton.addEventListener('click', function () {
            resetForm();
        });

        searchInput.addEventListener('input', filterNotes);
        sortInput.addEventListener('change', sortNotes);

        historyList.addEventListener('click', function (event) {
            const editButton = event.target.closest('.edit-note-btn');
            if (!editButton) {
                return;
            }

            const card = editButton.closest('.note-card');
            idInput.value = card.dataset.noteId || '0';
            noteInput.value = card.querySelector('.stored-note-text').value;
            signInput.value = card.querySelector('.stored-note-sign').value;
            dateInput.value = card.querySelector('.stored-note-date').value;
            timeInput.value = card.querySelector('.stored-note-time').value;

            formTitle.textContent = 'Edit Progress Note';
            saveButton.textContent = 'Update Note';
            updateCharacterCount();
            clearMessage();
            page.scrollIntoView({ behavior: 'smooth', block: 'start' });
            noteInput.focus();
        });

        saveButton.addEventListener('click', function () {
            clearMessage();

            const labId = Number.parseInt($('#txtLabId').val(), 10);
            const patientId = Number.parseInt($('#txtPatientId').val(), 10);
            const noteText = noteInput.value.trim();
            const signature = signInput.value.trim();

            // labId 0 is valid - it is the module scope, where an academic populates
            // a scenario. Testing for falsiness rejected 0 and made module patients
            // impossible to write notes against.
            if (Number.isNaN(labId) || !patientId) {
                showMessage('Please select a patient before saving a progress note.', false);
                return;
            }

            if (!dateInput.value || !timeInput.value) {
                showMessage('Date and time are required.', false);
                return;
            }

            if (!noteText) {
                showMessage('Progress Note is required.', false);
                noteInput.focus();
                return;
            }

            if (noteText.length > 2000) {
                showMessage('Progress Note cannot exceed 2000 characters.', false);
                noteInput.focus();
                return;
            }

            if (!signature) {
                showMessage('Signature or initials are required.', false);
                signInput.focus();
                return;
            }

            const payload = {
                Id: Number.parseInt(idInput.value, 10) || 0,
                LabId: labId,
                PatientId: patientId,
                NotesDate: dateInput.value + 'T' + timeInput.value + ':00',
                Notes: noteText,
                Sign: signature
            };

            saveButton.disabled = true;
            saveButton.textContent = payload.Id > 0 ? 'Updating...' : 'Saving...';

            $.ajax({
                type: 'POST',
                url: '/patient/addprogressnote',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (response) {
                    if (response && response.success) {
                        loadProgressNotesPage(response.message);
                        return;
                    }

                    showMessage(
                        response && response.message
                            ? response.message
                            : 'Unable to save the progress note.',
                        false
                    );
                    saveButton.disabled = false;
                    saveButton.textContent = payload.Id > 0 ? 'Update Note' : 'Save Note';
                },
                error: function (xhr) {
                    const response = xhr.responseJSON;
                    showMessage(
                        response && response.message
                            ? response.message
                            : 'Unable to save the progress note.',
                        false
                    );
                    saveButton.disabled = false;
                    saveButton.textContent = payload.Id > 0 ? 'Update Note' : 'Save Note';
                }
            });
        });

        setCurrentDateTime();
        updateCharacterCount();
        sortNotes();
    })();
</script>
