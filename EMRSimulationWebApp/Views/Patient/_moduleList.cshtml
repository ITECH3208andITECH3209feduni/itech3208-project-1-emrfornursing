@*
    Sprint 3, Requirement 1 - module table.
    Rendered on its own so the list can be refreshed by AJAX after a
    create / copy / rename / delete without reloading the whole page.
*@
@using EMRSimulation.Domain.Dtos;
@model IEnumerable<ModuleDto>
@{
    // Students may browse and open modules but never change them. Set by
    // ModuleController; defaults to false so a missing flag fails closed.
    var canManage = ViewData["CanManage"] as bool? ?? false;
}

<table id="moduleTable" class="display" style="width:100%">
    <thead>
        <tr>
            <th>Id</th>
            <th>Year Level</th>
            <th>Unit</th>
            <th>Module</th>
            <th>Patients</th>
            <th>Students</th>
            <th>Last Updated</th>
            <th></th>
            <th></th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @* No hand-rolled empty-state row here. A single <td colspan="9"> gives
           DataTables one cell where it expects nine, which raises "Requested
           unknown parameter" - and its default error mode is a blocking
           alert(). An empty <tbody> plus language.emptyTable below is the
           idiomatic way to show the same message safely. *@
        @foreach (var m in Model)
        {
            <tr data-module-id="@m.Id" data-module-name="@m.ModuleName" data-unit-id="@m.UnitId">
                <td>@m.Id</td>
                <td>@m.YearLevelName</td>
                <td>@(string.IsNullOrWhiteSpace(m.UnitCode) ? m.UnitName : $"{m.UnitCode} - {m.UnitName}")</td>
                <td>
                    <strong>@m.ModuleName</strong>
                    @if (!string.IsNullOrWhiteSpace(m.Description))
                    {
                        <div class="text-muted small">@m.Description</div>
                    }
                    @* Filled in after render by the lab-loads lookup below. Empty
                       unless this module is currently sitting in the caller's lab. *@
                    <div class="small labLoadStatus" data-module-id="@m.Id"></div>
                </td>
                <td>@m.PatientCount</td>
                <td>
                    @if (canManage)
                    {
                        @* Opens a per-lab panel. Visibility belongs to a module's
                           presence in one lab, not to the module: campuses run their
                           own timetables, so hiding a scenario at Berwick must not
                           hide it at Gippsland. *@
                        <a href="javascript:void(0);" class="btn btn-emr btn-sm moduleVisibility"
                           data-custom="@m.Id">Visibility</a>
                    }
                </td>
                <td>@((m.UpdatedDate ?? m.CreatedDate).ToString("yyyy-MM-dd"))</td>
                <td>
                    <a href="javascript:void(0);" class="btn btn-emr btn-sm openModule"
                       data-custom="@m.Id">Open</a>
                </td>
                <td>
                    @if (canManage)
                    {
                        <a href="javascript:void(0);" class="btn btn-emr btn-sm copyModule"
                           data-custom="@m.Id">Copy</a>
                    }
                </td>
                <td>
                    @if (canManage)
                    {
                        @* Loading replaces any previous copy in this lab, so the
                           label changes to Reload once one exists. Set below. *@
                        <a href="javascript:void(0);" class="btn btn-emr btn-sm loadIntoLab"
                           data-custom="@m.Id">Load into lab</a>
                    }
                </td>
                <td>
                    @if (canManage)
                    {
                        <a href="javascript:void(0);" class="btn btn-emr btn-sm renameModule"
                           data-custom="@m.Id">Rename</a>
                        <a href="javascript:void(0);" class="btn btn-danger btn-sm deleteModule"
                           data-custom="@m.Id">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    // DataTables defaults to alert() on error, which blocks the whole browser
    // tab until dismissed. Log to the console instead so a table problem can
    // never freeze an academic mid-class.
    if ($.fn.dataTable) { $.fn.dataTable.ext.errMode = 'none'; }

    var moduleTable = $('#moduleTable').on('error.dt', function (e, settings, techNote, message) {
        console.error('DataTables error on #moduleTable:', message);
    }).DataTable({
        "paging": true,
        "info": false,
        "searching": false,
        "ordering": true,
        "autoWidth": false,
        "lengthChange": false,
        "language": {
            "emptyTable": "No modules match. Use New Module to create a laboratory scenario, or clear the filters above."
        },
        "columnDefs": [
            { "targets": [0], "visible": false },
            { "targets": [7, 8, 9, 10], "orderable": false }
        ]
    });

    // --- per-lab student visibility -------------------------------------------
    // Shown as a DataTables child row rather than a modal: the panel belongs to the
    // module it expands, and row.child() survives paging and redraws.
    function visibilityPanel(moduleId, labs) {
        if (!labs.length) {
            return '<div class="visibility-panel text-muted small">' +
                   'This module is not loaded into any laboratory yet, so there is ' +
                   'nothing for students to see. Use Load into lab first.</div>';
        }

        var html = '<div class="visibility-panel">';

        labs.forEach(function (l) {
            var when = l.loadedAt
                ? new Date(l.loadedAt).toLocaleDateString() + ' ' +
                  new Date(l.loadedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                : 'earlier';

            html += '<label class="module-visibility">' +
                    '<input type="checkbox" class="toggleLabVisibility"' +
                        ' data-module="' + moduleId + '"' +
                        ' data-lab="' + l.labId + '"' +
                        (l.visibleToStudents ? ' checked' : '') + ' />' +
                    '<span class="visibility-lab">' + $('<div>').text(l.labName).html() + '</span>' +
                    '<span class="text-muted small">' + l.patientCount + ' patient(s), loaded ' + when + '</span>' +
                    '</label>';
        });

        return html + '</div>';
    }

    $(document).off('click.modvis').on('click.modvis', '.moduleVisibility', function () {
        var moduleId = parseInt($(this).attr('data-custom'), 10);
        var row      = moduleTable.row($(this).closest('tr'));

        if (row.child.isShown()) { row.child.hide(); return; }

        $.ajax({
            url: '/module/getmodulelabvisibility',
            method: 'GET',
            data: { moduleId: moduleId },
            success: function (labs) {
                row.child(visibilityPanel(moduleId, labs || [])).show();
            },
            error: function (xhr) {
                console.error('Could not read module visibility:', xhr.status);
            }
        });
    });

    // The checkbox follows what the server confirms, not what was clicked, so a
    // refused or failed request leaves the control showing the truth.
    $(document).off('change.modvis').on('change.modvis', '.toggleLabVisibility', function () {
        var $box   = $(this);
        var wanted = $box.is(':checked');

        $box.prop('disabled', true);

        $.ajax({
            url: '/module/setmodulelabvisibility',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                ModuleId: parseInt($box.attr('data-module'), 10),
                LabId: parseInt($box.attr('data-lab'), 10),
                VisibleToStudents: wanted
            }),
            success: function (res) { $box.prop('checked', res.visibleToStudents); },
            error: function (xhr) {
                $box.prop('checked', !wanted);   // put it back
                console.error(xhr.status === 403
                    ? 'Only a Supervisor login can change module visibility.'
                    : 'The module visibility could not be changed.');
            },
            complete: function () { $box.prop('disabled', false); }
        });
    });

    // Which of these modules already sit in this supervisor's lab. Runs on every
    // render of the list, so the badges stay correct after a load or a refresh.
    // Students get an empty array back, and the buttons are not rendered for them
    // anyway, so this is a no-op on the student view.
    $.ajax({
        url: '/module/getlabmoduleloads',
        method: 'GET',
        success: function (loads) {
            (loads || []).forEach(function (l) {
                var status = $('.labLoadStatus[data-module-id="' + l.moduleId + '"]');
                if (!status.length) return;

                var when = l.loadedAt ? new Date(l.loadedAt) : null;
                var whenText = when
                    ? when.toLocaleDateString() + ' ' + when.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                    : 'earlier';

                status.html('<span class="text-success">In your lab</span>' +
                            '<span class="text-muted"> - loaded ' + whenText + '</span>');

                $('.loadIntoLab[data-custom="' + l.moduleId + '"]')
                    .text('Reload into lab')
                    .removeClass('btn-success').addClass('btn-warning');
            });
        },
        error: function (xhr) {
            // Not worth interrupting the academic over; the badge is informational.
            console.error('Could not read lab module loads:', xhr.status);
        }
    });
</script>
